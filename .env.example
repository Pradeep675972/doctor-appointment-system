# Database Connection URL
# For local development: Optional. If omitted, Vitalis automatically uses an embedded local database (PGlite in ./.data/postgres)
# For production (Vercel): REQUIRED. Provide your PostgreSQL connection string (Neon, Supabase, AWS RDS, etc.)
# Examples:
# Neon: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_Wvmd0s3qPceG@ep-mute-boat-bd18v75k-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Cookie security flag (set to true in production HTTPS)
COOKIE_SECURE=false

# Optional connection pool size override (default is 10)
# DB_MAX_CONNECTIONS=10
